pipeline {

  agent any

  tools {

    nodejs 'nodejs-18.x.x'
  
  }

  stages {

    stage('APP: Verificando repositorio...') {
      steps {
        git url: 'https://github.com/oskrmarolv/tecgurus-devops-mar25-app.git', 
            branch: 'develop',
            credentialsId: 'tecgurus-github-token' 
      }
    }

    stage('APP: Instalando dependencias...') {
      steps {
        sh 'sleep 10'
        sh 'npm install'
      }
    }

    stage('Infraestructura: Verificando repositorio...') {
      steps {
        dir('devops_infra') {
          git url: 'https://github.com/oskrmarolv/tecgurus-devops-mar25-infa.git',
              branch: 'main',
              credentialsId: 'tecgurus-github-token',
              changelog: false,
              poll: false
        }
      }
    }

    stage('Infraestructura: Desplegando entorno de testing...') {
      steps {
        sh './devops_infra/start.sh'
      }
    }
  
  }

  options {
    timestamps()
  }

}