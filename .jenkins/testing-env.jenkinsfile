pipeline {

  agent any

  tools {

    nodejs 'nodejs-18.x.x'
  
  }

  environment {
  
    APP_PATH = "${WORKSPACE}"
  
  }

  options {
  
    timestamps()
  
  }

  stages {

    stage('APP: Verificando repositorio...') {
      steps {
        git url: 'https://github.com/oskrmarolv/tecgurus-devops-mar25-app.git', 
            branch: 'develop',
            credentialsId: 'tecgurus-github-token' 
      }
    }

    stage('APP: Instalando dependencias...') {
      steps {
        sh 'sleep 10'
        sh 'npm install'
      }
    }

    stage('Infraestructura: Verificando repositorio...') {
      steps {
        dir('devops_infra') {
          git url: 'https://github.com/oskrmarolv/tecgurus-devops-mar25-infra.git',
              branch: 'main',
              credentialsId: 'tecgurus-github-token',
              changelog: false,
              poll: false
        }
      }
    }

    stage('Infraestructura: Deteniendo despliegue previo...') {
      steps {
        dir('devops_infra/testing') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            sh 'docker compose down'
          }
        }
      }
    }

    stage('Infraestructura: Desplegando entorno de testing...') {
      steps {
        dir('devops_infra/testing') {
          sh 'docker compose up -d'
        }
      }
    }
  
  }

  post {

    always {
       sh 'echo "Finalizando pipeline..."'
    }
  
  }


}